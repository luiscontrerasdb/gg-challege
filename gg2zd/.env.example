# --- Atlassian (Confluence Cloud) ---
ATLASSIAN_SITE=https://mariadbcorp.atlassian.net
ATLASSIAN_EMAIL=you@mariadb.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=
# Optional: limit searches to one space (your personal space key)
CONFLUENCE_SPACE=~71202027e8c92a603646529ce56ebd66843566

# --- Zendesk Guide ---
ZENDESK_SUBDOMAIN=mariadb
ZENDESK_EMAIL=you@mariadb.com
# Admin Center > Apps and integrations > APIs > Zendesk API > Add API token
ZENDESK_API_TOKEN=
# Numeric ID of the Guide section (brand 20641285140365) where articles are created
ZENDESK_SECTION_ID=
ZENDESK_PERMISSION_GROUP_ID=
# Optional (empty = visible to everyone)
ZENDESK_USER_SEGMENT_ID=
ZENDESK_LOCALE=en-us
